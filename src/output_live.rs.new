// output_live.rs
use gpio_cdev::{Chip, LineHandle, LineRequestFlags};
use std::collections::BTreeMap;
use std::error::Error;
use std::sync::{Arc, Mutex};

use crate::loggin::Log;
use crate::motor::{MotorController, Output};

pub type LiveOutput = Output<LiveMotor, LiveMotor>;

pub fn init_output(log: Log, cfg: BTreeMap<String, String>) -> LiveOutput {
    let motor_l = LiveMotor::new(
        cfg["MOTORL_PINE"].parse::<u32>().unwrap_or_else(|_| {
            log.err("ISSUE at Motor L ENA");
            0
        }),
        cfg["MOTORL_PIN1"].parse::<u32>().unwrap_or_else(|_| {
            log.err("ISSUE at Motor L 1");
            0
        }),
        cfg["MOTORL_PIN2"].parse::<u32>().unwrap_or_else(|_| {
            log.err("ISSUE at Motor L 2");
            0
        }),
    )
    .expect("ERROR LOADING LEFT MOTOR");

    let motor_r = LiveMotor::new(
        cfg["MOTORR_PINE"].parse::<u32>().unwrap_or_else(|_| {
            log.err("ISSUE at Motor R ENA");
            0
        }),
        cfg["MOTORR_PIN1"].parse::<u32>().unwrap_or_else(|_| {
            log.err("ISSUE at Motor R 1");
            0
        }),
        cfg["MOTORR_PIN2"].parse::<u32>().unwrap_or_else(|_| {
            log.err("ISSUE at Motor R 2");
            0
        }),
    )
    .expect("ERROR LOADING RIGHT MOTOR");

    Output {
        sensor: "on".to_string(),
        sensor_prio: 0,
        motor_l,
        motor_r,
    }
}

#[derive(Debug, Clone)]
pub struct LiveMotor {
    enable: Arc<Mutex<LineHandle>>,
    in1: Arc<Mutex<LineHandle>>,
    in2: Arc<Mutex<LineHandle>>,
    speed: f32,
    priority: u8,
}

impl LiveMotor {
    pub fn new(enable_pin: u32, in1_pin: u32, in2_pin: u32) -> Result<Self, Box<dyn Error>> {
        let mut chip = Chip::new("/dev/gpiochip0")?;

        let enable = chip
            .get_line(enable_pin)?
            .request(LineRequestFlags::OUTPUT, 0, "MOTOR_EN")?;
        let in1 = chip
            .get_line(in1_pin)?
            .request(LineRequestFlags::OUTPUT, 0, "MOTOR_IN1")?;
        let in2 = chip
            .get_line(in2_pin)?
            .request(LineRequestFlags::OUTPUT, 0, "MOTOR_IN2")?;

        Ok(Self {
            enable: Arc::new(Mutex::new(enable)),
            in1: Arc::new(Mutex::new(in1)),
            in2: Arc::new(Mutex::new(in2)),
            speed: 0.0,
            priority: 0,
        })
    }
}

impl MotorController for LiveMotor {
    fn set_speed(&mut self, speed: f32) {
        let factor = 1.0;
        let speed_factored = (speed * factor) as i32;
        
        if let Err(e) = self.set_hardware_speed(speed_factored) {
            eprintln!("Error setting motor speed: {}", e);
        } else {
            self.speed = speed;
        }
    }

    fn get_speed(&self) -> f32 {
        self.speed
    }

    fn get_priority(&self) -> u8 {
        self.priority
    }

    fn set_priority(&mut self, prio: u8) {
        self.priority = prio;
    }
}

impl LiveMotor {
    fn set_hardware_speed(&mut self, speed: i32) -> Result<(), Box<dyn Error>> {
        let enable = self.enable.lock().unwrap();
        let in1 = self.in1.lock().unwrap();
        let in2 = self.in2.lock().unwrap();
        
        if speed > 0 {
            in1.set_value(1)?;
            in2.set_value(0)?;
            enable.set_value(1)?;
        } else if speed < 0 {
            in1.set_value(0)?;
            in2.set_value(1)?;
            enable.set_value(1)?;
        } else {
            in1.set_value(0)?;
            in2.set_value(0)?;
            enable.set_value(0)?;
        }
        Ok(())
    }
}
