// output_test.rs
use crate::loggin::Log;
use crate::motor::{MotorController, Output};

pub type TestOutput = Output<TestMotor, TestMotor>;

pub fn init_output(log: Log) -> TestOutput {
    log.info("Loading motors...");
    
    Output {
        sensor: "on".to_string(),
        sensor_prio: 0,
        motor_l: TestMotor::new(1),
        motor_r: TestMotor::new(2),
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct TestMotor {
    motor_id: u16,
    speed: f32,
    priority: u8,
}

impl TestMotor {
    pub fn new(motor_id: u16) -> Self {
        Self {
            motor_id,
            speed: 0.0,
            priority: 0,
        }
    }
}

impl MotorController for TestMotor {
    fn set_speed(&mut self, speed: f32) {
        self.speed = speed;
    }

    fn get_speed(&self) -> f32 {
        self.speed
    }

    fn get_priority(&self) -> u8 {
        self.priority
    }

    fn set_priority(&mut self, prio: u8) {
        self.priority = prio;
    }
}
